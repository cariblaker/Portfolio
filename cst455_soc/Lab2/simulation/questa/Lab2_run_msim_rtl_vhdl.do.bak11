transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vcom -93 -work work {/home/cari/cst455_soc/Lab2/sev_seg_decoder.vhd}

vlog -vlog01compat -work work +incdir+/home/cari/cst455_soc/Lab2/simulation/questa {/home/cari/cst455_soc/Lab2/simulation/questa/sev_seg_decoder_tb.v}

vsim -t 1ps -L altera -L lpm -L sgate -L altera_mf -L altera_lnsim -L cyclonev -L cyclonev_hssi -L rtl_work -L work -voptargs="+acc"  sev_seg_decoder_tb

add wave *
view structure
view signals
run 200 ns
