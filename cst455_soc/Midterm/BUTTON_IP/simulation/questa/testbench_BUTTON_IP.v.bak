`timescale 1ns / 1ps

module testbench_BUTTON_IP ();

    wire [31:0] readdata;
    reg [31:0] writedata;
    reg [1:0] address;
    reg chipselect;
    reg clk;
    reg reset_n;
	 reg read;
    reg write;
    wire [6:0] seg_out;
	 
	 BUTTON_IP	UUT1 (address, chipselect, clk, reset_n, write, read, button_in, writedata, readdata, button_out);
	 
	 always
		begin
			#10 clk <= ~clk;
		end
		
	initial
		begin
			clk <= 1'b0;
			writedata <= 32'h00000000;
			address <= 2'b0;
			chipselect <= 1'b0;
			read <= 1'b0;
			write <= 1'b0;
			reset_n <= 1'b0;
			#10 button_in <= 1'b0;
			#15 reset_n <= 1'b1;
			#10 button_in <= 1'b1;
			#20 button_in <= 1'b0;
			#40 button_in <= 1'b1;
			#10 reset_n <= 1'b0;
		end
		
	always @(posedge clk or negedge reset_n)
		begin
			writedata <= writedata + 1;
			if (writedata >= 12)
				writedata <= 32'h00000000;
		end
endmodule