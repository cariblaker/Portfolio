int main() {
    printf("Hello FreeRTOS from main!\n");

    // Create the message queue
    modeQueue = xQueueCreate(10, sizeof(uint8_t));
    if (modeQueue == NULL) {
        printf("Failed to create queue\n");
        return -1;
    }

    // Create the LED task
    if (pdFAIL == xTaskCreate(led_task, "LED Task", TASK_STACKSIZE, NULL, LED_TASK_PRIORITY, NULL)) {
        printf("LED task creation failed...\n");
    }

    // Create the Button task
    if (pdFAIL == xTaskCreate(button_task, "Button Task", TASK_STACKSIZE, NULL, BUTTON_TASK_PRIORITY, NULL)) {
        printf("Button task creation failed...\n");
    }

    // Start the scheduler
    vTaskStartScheduler();

    while (1) {}
    return 0;
}
