#define TASK_STACKSIZE 2048
#define BUTTON_TASK_PRIORITY (tskIDLE_PRIORITY)
#define LED_TASK_PRIORITY (tskIDLE_PRIORITY + 1)

int ms_slept = 750 / portTICK_PERIOD_MS;
uint8_t mode;

// Queue handle for communication between button and LED tasks
QueueHandle_t modeQueue;

void led_task(void* pvParameters) {
    uint16_t count = 0;             // For the up-counter
    uint16_t cylon_count = 0;       // For the cylon pattern
    uint8_t custom_count = 0;       // Separate counter for the custom LED pattern

    while (1) {
        // Wait for a new mode message from the button task
        if (xQueueReceive(modeQueue, &mode, 0)) {
            printf("LED Task: Mode changed to %d\n", mode);
        }

        // Set LEDs based on the current mode
        switch (mode) {
            case 0:
                // Blink LEDs
                IOWR(LEDS_BASE, 0, 0x3FF); // All LEDs ON
                vTaskDelay(ms_slept);
                IOWR(LEDS_BASE, 0, 0x000); // All LEDs OFF
                break;

            case 1:
                // Cylon pattern
                IOWR(LEDS_BASE, 0, 1 << (cylon_count % 10));
                cylon_count++;
                if (cylon_count >= 10) cylon_count = 0;
                break;

            case 2:
                // Up-counter pattern
                IOWR(LEDS_BASE, 0, count);
                count++;
                if (count == 1024) count = 0;
                break;

            case 3:
                // Custom expanding and contracting pattern
                switch (custom_count) {
                    case 0: IOWR(LEDS_BASE, 0, 0x201); break;
                    case 1: IOWR(LEDS_BASE, 0, 0x303); break;
                    case 2: IOWR(LEDS_BASE, 0, 0x387); break;
                    case 3: IOWR(LEDS_BASE, 0, 0x3CF); break;
                    case 4: IOWR(LEDS_BASE, 0, 0x3FF); break;
                    case 5: IOWR(LEDS_BASE, 0, 0x1FE); break;
                    case 6: IOWR(LEDS_BASE, 0, 0x0FC); break;
                    case 7: IOWR(LEDS_BASE, 0, 0x078); break;
                    case 8: IOWR(LEDS_BASE, 0, 0x030); break;
                    case 9: IOWR(LEDS_BASE, 0, 0x000); break;
                }
                custom_count++;
                if (custom_count >= 10) custom_count = 0; // Reset custom_count after completing the pattern
                break;
        }

        vTaskDelay(ms_slept); // Delay for smooth transitions
    }
}

