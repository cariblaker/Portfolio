// Lookup table for hexadecimal digits 0x0 - 0xF for seven-segment encoding
const int hex_to_seven_segment[16] = {
    0x3F, // 0
    0x06, // 1
    0x5B, // 2
    0x4F, // 3
    0x66, // 4
    0x6D, // 5
    0x7D, // 6
    0x07, // 7
    0x7F, // 8
    0x6F, // 9
    0x77, // A
    0x7C, // b
    0x39, // C
    0x5E, // d
    0x79, // E
    0x71  // F
};

// Function to convert binary input from switches to hex and output on 7-segment displays
void convert_to_hex(int switch_value) {
    // Mask out switch0 and shift right to ignore the reset switch
    int masked_value = (switch_value & 0xFE) >> 1;

    // Extract the lower nibble (4 bits) for the first display, upper nibble for the second
    int lower_digit = masked_value & 0xF;         // Lower nibble
    int upper_digit = (masked_value >> 4) & 0xF;  // Upper nibble

    // Convert each nibble to seven-segment encoding
    int display_lower = hex_to_seven_segment[lower_digit];
    int display_upper = hex_to_seven_segment[upper_digit];

    // Output to 7-segment displays
    IOWR_ALTERA_AVALON_PIO_DATA(HEX0_BASE, display_lower); // Assumes HEX0 is the lower digit
    IOWR_ALTERA_AVALON_PIO_DATA(HEX1_BASE, display_upper); // Assumes HEX1 is the upper digit
}

